# Mehran AI - Backend Environment Configuration

# Choose provider: "gemini" or "openai"
LLM_PROVIDER=gemini

# If using Gemini (Google AI Studio - free tier available):
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

# If using OpenAI:
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Security Settings
# Comma-separated list of allowed origins for CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000,http://127.0.0.1:8000,http://127.0.0.1:5500,https://mehran-sec.github.io

# Max requests per minute per IP address
RATE_LIMIT_PER_MINUTE=10
